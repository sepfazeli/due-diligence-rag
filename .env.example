# ─────────────────────────────────────────────────────────────
# due-diligence-rag — environment variables (TEMPLATE)
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is gitignored — never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Anthropic Claude — used by the /api/analyze route to produce the
# grounded answer, risk flags, and structured JSON output.
# Create a key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI — used ONLY for embeddings (model: text-embedding-3-small),
# both during ingestion and to embed the user's question at query time.
# Create a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Cohere — used by the retrieval module to rerank the top vector +
# full-text candidates (Cohere Rerank) before building LLM context.
# Create a key: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# Neon Postgres connection string. The database MUST have the
# pgvector extension available (the migration enables it).
# Format: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Read by both Prisma (app) and the Python ingestion pipeline.
DATABASE_URL=
